{
  "name": "quienlodijo-game",
  "version": "0.1.0",
  "description": "Party trivia game: ¿Quién lo dijo? Jesús vs. Karl Marx",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "ng run quienlodijo-game:storybook",
    "build-storybook": "ng run quienlodijo-game:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lottie-web": "^5.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.34",
    "@angular-devkit/build-angular": "^20.3.34",
    "@angular-devkit/core": "^20.3.0",
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/angular": "^9.1.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^20.19.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^9.1.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
